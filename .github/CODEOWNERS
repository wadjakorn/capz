/src/lib/ocr.ts                               @wadjakorn
/src/lib/updater.ts                           @wadjakorn
/src/lib/accessibility.ts                     @wadjakorn

# Persistence (tauri-plugin-store, workspaces) — data loss is not testable on /paste.
